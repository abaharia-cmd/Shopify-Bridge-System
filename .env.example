# Shopify Admin API
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Pin to a currently-supported Shopify Admin API version (quarterly cadence).
# As of 2026-05-01: 2025-07, 2025-10, 2026-01, 2026-04, 2026-07.
SHOPIFY_API_VERSION=2026-01

# Supabase (server-only — never expose SECRET_KEY to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Direct DB connection — only needed for local migrations / type generation
# Note: special chars in password must be URL-encoded (@ -> %40)
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:URLENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Phase 3B — incremental sync infrastructure
# Webhook signing secret (Shopify webhook config → API → "Webhook signing secret")
# Used by /api/webhooks/shopify to verify HMAC of incoming webhook bodies.
SHOPIFY_WEBHOOK_SECRET=any-random-64-char-hex-string
# Daily catchup-sync cron auth (Vercel Cron sends as Authorization: Bearer)
# Generate with: openssl rand -hex 32
CATCHUP_CRON_SECRET=any-random-64-char-hex-string

# Logging
LOG_LEVEL=info
